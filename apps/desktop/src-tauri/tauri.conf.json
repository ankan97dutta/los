{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOS",
  "version": "0.1.0",
  "identifier": "com.los.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @los/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @los/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LOS — Lead OS",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
